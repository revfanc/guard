{
  "name": "@revfanc/guard",
  "version": "0.5.0",
  "description": "A small, framework-agnostic browser back guard.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "dev": "tsdown --watch",
    "build": "tsdown",
    "typecheck": "pnpm typecheck:build && pnpm typecheck:project",
    "typecheck:build": "tsc -p tsconfig.build.json --noEmit",
    "typecheck:package": "tsc -p scripts/type-tests/tsconfig.json",
    "typecheck:project": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm docs:build",
    "pack:check": "pnpm build && pnpm typecheck:package && node scripts/check-pack.mjs && node scripts/check-treeshaking.mjs && publint && attw --pack .",
    "prepack": "pnpm build"
  },
  "keywords": [
    "browser",
    "back-button",
    "history-api",
    "navigation",
    "guard"
  ],
  "author": "revfanc",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/revfanc/guard.git"
  },
  "bugs": {
    "url": "https://github.com/revfanc/guard/issues"
  },
  "homepage": "https://revfanc.github.io/guard/",
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "pnpm@10.33.0",
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.8.1",
    "globals": "^17.11.0",
    "jsdom": "^30.0.1",
    "publint": "^0.3.23",
    "rolldown": "^1.2.4",
    "tsdown": "^0.22.14",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.1",
    "vitepress": "2.0.0-alpha.19",
    "vitest": "^4.1.10",
    "vue": "^3.5.41"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
