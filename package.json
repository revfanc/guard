{
  "name": "@revfanc/guard",
  "version": "0.1.0",
  "description": "A small, framework-agnostic browser back guard.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "dev": "tsup --watch",
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm docs:build",
    "pack:check": "node scripts/check-pack.mjs"
  },
  "keywords": [
    "browser",
    "back-button",
    "history-api",
    "navigation",
    "guard"
  ],
  "author": "revfanc",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/revfanc/guard.git"
  },
  "bugs": {
    "url": "https://github.com/revfanc/guard/issues"
  },
  "homepage": "https://revfanc.github.io/guard/",
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "pnpm@10.33.0",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitejs/plugin-vue": "^6.0.8",
    "eslint": "^10.8.1",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^17.11.0",
    "jsdom": "^30.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.2",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.1",
    "vitepress": "^1.6.4",
    "vitest": "^4.1.10",
    "vue": "^3.5.41",
    "vue-eslint-parser": "^10.4.1",
    "vue-router": "^5.2.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
